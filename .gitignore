# Allowlist: only the tool is tracked, so docs generated in this folder never land in the public repo.
/*
!/.gitignore
!/new_doc.py
!/test_new_doc.py
!/README.md
!/install.sh
!/help.sh
!/to_check_in_case_of_failure.md
!/finish_doc.py
!/samples/
!/fill_slides.py
!/test_fill_slides.py

# Generated documents and slides
/docs/
